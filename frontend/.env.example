# Copy to frontend/.env and fill in after creating your Supabase project.
# The app works in DEMO MODE (no login) even if these are blank.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI backend (8099 avoids the 8000/8077 clashes on your machine)
VITE_API_URL=http://127.0.0.1:8099
