# ======================================================================
#  RADIX Talent Match — backend environment
#  Copy this file to ".env" and fill in the values you have.
# ======================================================================

# ---- Which LLM powers JD/resume skill extraction ----
# Options: groq | openai | grok | anthropic | local
#   groq   -> free & fast, OpenAI-compatible (RECOMMENDED for the hackathon)
#   local  -> no API key at all; uses a built-in keyword/heuristic extractor
LLM_PROVIDER=groq

# ---- Groq (default). Get a free key at https://console.groq.com/keys ----
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- OpenAI (optional) ----




OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- xAI / Grok (optional) ----
XAI_API_KEY=
XAI_MODEL=grok-3

# ---- Anthropic / Claude (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Supabase (fill after you create the project; safe to leave blank for local dev) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Company-intelligence universe (second Supabase project, server-side only) ----
COMPANIES_SUPABASE_URL=
COMPANIES_SUPABASE_SERVICE_KEY=

# ---- CORS: where the React dev server runs ----
FRONTEND_ORIGIN=http://localhost:5173
